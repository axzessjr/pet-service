# Copy to review/.env (Git ignores it) and fill in your MongoDB Atlas
# connection string: Atlas > your cluster > Connect > Drivers.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=pawpal
MONGODB_DB=reviews

# Working offline: run `docker compose --profile local-db up -d --build`
# and use the local database instead.
# MONGODB_URL=mongodb://review:review@review-db:27017/?authSource=admin
