# Copy this file to .env at the repository root. Keep atlas-client.pem beside it.
# Supabase server-side PostgreSQL connection.
DATABASE_URL='postgresql://<user>:<password>@<supabase-pooler-host>:5432/postgres'

# Atlas X.509 authentication. The PEM contains the certificate and private key.
MONGODB_URL='mongodb+srv://<cluster>.mongodb.net/?authMechanism=MONGODB-X509&authSource=%24external&tls=true&retryWrites=true&w=majority'
MONGODB_DB='reviews'
MONGODB_TLS_CERTIFICATE_KEY_FILE='atlas-client.pem'

# Native local services use localhost; Compose supplies the container hostname.
RABBITMQ_URL='amqp://pawpal:pawpal@localhost:5672'
